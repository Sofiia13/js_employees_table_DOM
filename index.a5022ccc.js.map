form.appendChild(inputName);
var inputPosition = addInput("text", "position", "data-qa", "Position:");
form.appendChild(inputPosition);
var inputOffice = addInput("select", "office", "data-qa", "Office:", [
    "Tokyo",
    "Singapore",
    "London",
    "New York",
    "Edinburgh",
    "San Francisco"
]);
form.appendChild(inputOffice);
var inputAge = addInput("number", "age", "data-qa", "Age:");
form.appendChild(inputAge);
var inputSalary = addInput("number", "salary", "data-qa", "Salary:");
form.appendChild(inputSalary);
var button = document.createElement("button");
button.textContent = "Save to table";
form.appendChild(button);
